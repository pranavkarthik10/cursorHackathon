# HTTPS Project URL from Supabase → Settings → API (same value can be used for both lines).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
OPENAI_API_KEY=

# Direct Postgres URI (Settings → Database → Connection string). Used by `npm run db:init`. Prefer port 5432.
# DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@db.[ref].supabase.co:5432/postgres

# Optional: Supabase auth user UUID (Dashboard → Authentication → Users) for scripts/seed-insights.mjs personal rows.
# SEED_PERSONAL_USER_ID=
